# Copy to .env and fill in. Never commit .env.

# Local docker-compose Postgres. For prod, the Neon connection string (add ?sslmode=require).
DATABASE_URL=postgresql://sift:sift@localhost:5433/sift

# Corpus window in months (1 = MVP, 3 = full v1 corpus)
HARVEST_MONTHS=1

# https://www.semanticscholar.org/product/api#api-key-form
SEMANTIC_SCHOLAR_API_KEY=
